# Fin de línea normalizado (Windows/Linux/macOS)
* text=auto eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binarios: Git no debe intentar mezclarlos ni convertir fines de línea
*.xlsx binary
*.nc binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.mp4 binary
*.webm binary

