    title: "GRACE-based analysis of groundwater sustainability in the tropics"
    authors:
      - family-names: "Romero"
        given-names: "P."
      - family-names: "Piña"
        given-names: "A."
    journal: "Journal of Hydrology: Regional Studies"
    volume: 62
    start: 102756
